#! /bin/sh

log="${HSD_LOG_LEVEL:-info}"
extra="${HSD_ADDITIONAL_PARAMS:- --no-sig0 --no-wallet}"

dir="/opt/data/hsd"
mkdir -p ${dir}
chown -R hsd: ${dir}

listen="--ns-host 0.0.0.0 --rs-host 0.0.0.0"
migrate="--chain-migrate=4 --wallet-migrate=7"
data_dir="--prefix=${dir}"
log_level="--log-level=${log}"

params="${listen} ${migrate} ${data_dir} ${extra} ${log_level}"

exec su -s /bin/sh hsd -c "exec /usr/local/hsd/bin/hsd ${params} 2>&1 | logger -t hsd"
