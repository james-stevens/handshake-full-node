#! /bin/sh

log="info"
if test "${HSD_LOG_LEVEL}"; then log="${HSD_LOG_LEVEL}"; fi

if test -z "${HSD_ADDITIONAL_PARAMS}"; then HSD_ADDITIONAL_PARAMS="--no-sig0 --no-wallet"; fi

dir="/opt/data/hsd"
mkdir -p ${dir}
chown -R hsd: ${dir}

migrate="--chain-migrate=4 --wallet-migrate=7"
data_dir="--prefix=${dir}"
log_level="--log-level=${log}"

exec su -s /bin/sh hsd -c \
	"exec /usr/local/hsd/bin/hsd ${migrate} ${data_dir} ${HSD_ADDITIONAL_PARAMS} ${log_level} 2>&1 | logger -t hsd"
